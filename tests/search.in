# search (trie, whole system) vs find (BFS, one subtree)
mkdir docs docs/reports docs/old src
touch report.txt docs/report.txt docs/old/report.txt docs/reports/q1.txt
touch src/rep.c src/main.c src/Readme.md
# every name starting with "rep", sorted by name
search rep
search report
search reports
search r
# case-sensitive
search R
search xyz
search rep*
# errors
search
# removing a file removes it from the trie
search report
search rep
