# search (trie, whole system) vs find (BFS, one subtree)
fs:/$ mkdir docs docs/reports docs/old src
fs:/$ touch report.txt docs/report.txt docs/old/report.txt docs/reports/q1.txt
fs:/$ touch src/rep.c src/main.c src/Readme.md
# every name starting with "rep", sorted by name
fs:/$ search rep
/src/rep.c
/report.txt
/docs/report.txt
/docs/old/report.txt
/docs/reports
fs:/$ search report
/report.txt
/docs/report.txt
/docs/old/report.txt
/docs/reports
fs:/$ search reports
/docs/reports
fs:/$ search r
/src/rep.c
/report.txt
/docs/report.txt
/docs/old/report.txt
/docs/reports
# case-sensitive
fs:/$ search R
/src/Readme.md
fs:/$ search xyz
no matches
fs:/$ search rep*
no matches
# find: exact name, nearest first (level by level)
fs:/$ find / report.txt
/report.txt
/docs/report.txt
/docs/old/report.txt
(visited 12 inodes)
fs:/$ find docs report.txt
/docs/report.txt
/docs/old/report.txt
(visited 6 inodes)
fs:/$ find docs/old report.txt
/docs/old/report.txt
(visited 2 inodes)
fs:/$ find / reports
/docs/reports
(visited 12 inodes)
fs:/$ find / nothing
no matches
(visited 12 inodes)
fs:/$ find src main.c
/src/main.c
(visited 4 inodes)
# errors
fs:/$ find nothere x
error: no such directory: nothere
fs:/$ find report.txt x
error: not a directory: report.txt
fs:/$ find /
usage: find <dir> <name>
fs:/$ search
usage: search <prefix>
# removing a file removes it from the trie
fs:/$ rm docs/report.txt
fs:/$ search report
/report.txt
/docs/old/report.txt
/docs/reports
fs:/$ rm -r docs
fs:/$ search rep
/src/rep.c
/report.txt
