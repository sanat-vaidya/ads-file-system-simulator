# limits: disk full, inode limit, name rules
# 64 blocks x 32 bytes = 2048 bytes
write big1 
write big2 
write big3 
write big4 
write big5 
write big6 
df
# 5 blocks needed, only 4 free: error, and no file is created
write big7 gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg
ls
# overwriting can reuse the file's own blocks: 10 old + 4 free = 14
write big1 
df
stat big1
# disk is full: these fail and change nothing
append big2 x
stat big2
write big3 
stat big3
# empty files need no blocks
touch empty
write empty hi
stat empty
rm big1 big2 big3 big4 big5 big6 empty
df
# names: letters, digits, . _ - and at most 32 characters
touch nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
touch nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
touch with.dots_and-dashes
mkdir bad/slash
mkdir bad$
ls
rm nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn with.dots_and-dashes
# inode limit: 128 including the root
touch i001 i002 i003 i004 i005 i006 i007 i008 i009 i010 i011 i012 i013 i014 i015 i016 i017 i018 i019 i020
touch i021 i022 i023 i024 i025 i026 i027 i028 i029 i030 i031 i032 i033 i034 i035 i036 i037 i038 i039 i040
touch i041 i042 i043 i044 i045 i046 i047 i048 i049 i050 i051 i052 i053 i054 i055 i056 i057 i058 i059 i060
touch i061 i062 i063 i064 i065 i066 i067 i068 i069 i070 i071 i072 i073 i074 i075 i076 i077 i078 i079 i080
touch i081 i082 i083 i084 i085 i086 i087 i088 i089 i090 i091 i092 i093 i094 i095 i096 i097 i098 i099 i100
touch i101 i102 i103 i104 i105 i106 i107 i108 i109 i110 i111 i112 i113 i114 i115 i116 i117 i118 i119 i120
touch i121 i122 i123 i124 i125 i126 i127
df
touch one-too-many
mkdir one-too-many
write one-too-many hi
rm i001
touch now-it-fits
df
search now
# unknown commands and bad usage
format c:
cat
cat a b
ls a b
stat
blocks
write
touch
mkdir
