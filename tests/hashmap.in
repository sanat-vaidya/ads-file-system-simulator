# inode table: hash map with 31 buckets, bucket = id % 31
mkdir docs
touch docs/a docs/b
hashmap
stat docs/b
# make more than 31 inodes so buckets start sharing (collisions)
mkdir m
touch m/f01 m/f02 m/f03 m/f04 m/f05 m/f06 m/f07 m/f08 m/f09 m/f10
touch m/f11 m/f12 m/f13 m/f14 m/f15 m/f16 m/f17 m/f18 m/f19 m/f20
touch m/f21 m/f22 m/f23 m/f24 m/f25 m/f26 m/f27 m/f28 m/f29 m/f30
hashmap
stat m/f28
# ids are never reused: removing and re-creating gives a new id
rm docs/a
touch docs/a
stat docs/a
hashmap
rm -r m
hashmap
df
