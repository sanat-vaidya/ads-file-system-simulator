# inode table: hash map with 31 buckets, bucket = id % 31
fs:/$ mkdir docs
fs:/$ touch docs/a docs/b
fs:/$ hashmap
inode table: 4 inodes, 31 buckets, load factor 0.13, longest chain 1
  bucket  0: 0 (/)
  bucket  1: 1 (docs)
  bucket  2: 2 (a)
  bucket  3: 3 (b)
fs:/$ stat docs/b
path:    /docs/b
type:    file
inode:   3 (hash bucket 3)
parent:  1 (/docs)
size:    0 bytes, 0 blocks
blocks:  (no blocks)
# make more than 31 inodes so buckets start sharing (collisions)
fs:/$ mkdir m
fs:/$ touch m/f01 m/f02 m/f03 m/f04 m/f05 m/f06 m/f07 m/f08 m/f09 m/f10
fs:/$ touch m/f11 m/f12 m/f13 m/f14 m/f15 m/f16 m/f17 m/f18 m/f19 m/f20
fs:/$ touch m/f21 m/f22 m/f23 m/f24 m/f25 m/f26 m/f27 m/f28 m/f29 m/f30
fs:/$ hashmap
