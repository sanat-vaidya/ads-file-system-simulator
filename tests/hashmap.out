path:    /m/f28
type:    file
inode:   32 (hash bucket 1)
parent:  4 (/m)
size:    0 bytes, 0 blocks
blocks:  (no blocks)
# ids are never reused: removing and re-creating gives a new id
fs:/$ rm docs/a
fs:/$ touch docs/a
fs:/$ stat docs/a
path:    /docs/a
type:    file
inode:   35 (hash bucket 4)
parent:  1 (/docs)
size:    0 bytes, 0 blocks
blocks:  (no blocks)
