# rm frees names, inodes and disk blocks
mkdir docs docs/old empty
write docs/a.txt aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
write docs/old/b.txt bbbbbbbbbb
write top.txt top
df
diskmap
# remove one file
rm top.txt
ls
# empty directory
rm empty
# non-empty directory needs -r
rm docs
rm -r docs
tree
df
diskmap
search a
# freed blocks are reused, lowest number first
write new.txt reuse
blocks new.txt
# several at once
touch x y z
rm x z
ls
# errors
rm /
rm nothere
rm
rm -r
mkdir keep keep/inner
cd keep/inner
rm /keep
rm -r /keep
rm .
cd /
rm -r keep
ls
